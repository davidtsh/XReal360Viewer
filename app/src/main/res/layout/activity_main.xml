<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#303030">

    <ImageView
        android:id="@+id/imgSphereLogo"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginTop="124dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_360"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvInstructionsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/main_instructions_header"
        android:textColor="#C9C9C9"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnPickImage" />

    <View
        android:id="@+id/btnPickImageGlow"
        android:layout_width="278dp"
        android:layout_height="73dp"
        android:layout_marginTop="300dp"
        android:alpha="0.25"
        android:background="@drawable/bg_open_file_button_glow"
        android:elevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPickImage"
        android:layout_width="254dp"
        android:layout_height="57dp"
        android:layout_marginTop="308dp"
        android:background="@drawable/bg_open_file_button"
        android:elevation="4dp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:letterSpacing="0.24"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="@string/open_360_file"
        android:textAllCaps="false"
        android:textColor="#C9C9C9"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/tvInstructions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="32dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvInstructionsHeader">

        <TextView
            style="@style/MainInstructionLine"
            android:text="@string/instruction_pinch" />

        <TextView
            style="@style/MainInstructionLine"
            android:layout_marginTop="11dp"
            android:text="@string/instruction_shake" />

        <TextView
            style="@style/MainInstructionLine"
            android:layout_marginTop="11dp"
            android:text="@string/instruction_swipe" />



        <TextView
            style="@style/MainInstructionLine"
            android:layout_marginTop="11dp"
            android:text="@string/instruction_hold" />

        <TextView
            style="@style/MainInstructionLine"
            android:layout_marginTop="11dp"
            android:text="@string/instruction_two_finger_tap" />

        <TextView
            style="@style/MainInstructionLine"
            android:layout_marginTop="11dp"
            android:text="@string/instruction_two_finger_hold" />

        <TextView
            style="@style/MainInstructionLine"
            android:layout_marginTop="11dp"
            android:text="@string/instruction_tap" />


    </LinearLayout>

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:text="@string/version_fallback"
        android:textColor="#A1A1A1"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:letterSpacing="0.45"
        android:text="@string/main_credit"
        android:textColor="#A1A1A1"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/tvVersion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
